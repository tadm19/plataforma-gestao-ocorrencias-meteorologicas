{
  "name": "backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "docker:build": "docker build -t meteo-backend .",
    "docker:run": "docker run --rm --name meteo-backend --env-file .env -p 3000:3000 meteo-backend",
    "check": "node --check server.js && node --check routes/auth.js && node --check routes/ocorrencias.js && node --check services/db.js && node --check services/blob.js && node --check middleware/auth.js",
    "test": "npm run check"
  },
  "dependencies": {
    "@azure/cosmos": "^3.17.3",
    "@azure/storage-blob": "^12.31.0",
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  }
}
